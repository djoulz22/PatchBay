{
  "manifest_version": 3,
  "name": "Patchbay - Capture d'onglet",
  "description": "Envoie l'audio des onglets choisis à Patchbay sur ce Mac.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*"
  },
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Envoyer l'onglet à Patchbay" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
