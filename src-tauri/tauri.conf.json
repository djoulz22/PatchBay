{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchbay",
  "version": "0.2.9",
  "identifier": "fr.patchbay.audio",
  "build": {
    "beforeDevCommand": "corepack pnpm dev:web",
    "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Patchbay",
        "width": 1320,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": {
      "../LICENSE-TALKTRACK": "licenses/TalkTrack.txt",
      "../browser-extension/chromium/": "browser-extension/chromium/",
      "target/driver/Patchbay.driver/": "driver/Patchbay.driver/"
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
